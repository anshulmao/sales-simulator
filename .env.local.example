# OpenAI API key — server-side only. Do NOT prefix with NEXT_PUBLIC_ (that would
# inline the secret into the browser bundle). The token route reads this to mint
# a short-lived ephemeral client secret; the raw key never reaches the client.
OPENAI_API_KEY=sk-...

# Optional: run the whole call screen with fake data and zero network calls.
# Set to "true" to force mock mode (useful before the backend/API tier is ready).
NEXT_PUBLIC_USE_MOCK_SESSION=false
